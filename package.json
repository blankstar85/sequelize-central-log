{
  "name": "sequelize-central-log",
  "version": "6.1.0",
  "description": "Maintain a central history of changes to tables ( models ) in sequelize.",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --quiet",
    "release": "release-it",
    "test": "mocha --import=tsx --timeout 10000 \"src/**/*.spec.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepare": "husky",
    "lint:fix": "eslint src --fix"
  },
  "keywords": [
    "sequelize",
    "revision",
    "history",
    "audit",
    "papertrail",
    "tracking",
    "log",
    "trail"
  ],
  "author": "blankstar85",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blankstar85/sequelize-central-log.git"
  },
  "bugs": {
    "url": "https://github.com/blankstar85/sequelize-central-log/issues"
  },
  "private": false,
  "peerDependencies": {
    "cls-hooked": "^4.2.2",
    "sequelize": "^6.37.0"
  },
  "peerDependenciesMeta": {
    "cls-hooked": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/cls-hooked": "^4.3.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "cls-hooked": "^4.2.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mariadb": "^3.5.4",
    "mocha": "^12.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "prettier": "^3.9.10",
    "release-it": "^21.0.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test"
      ],
      "after:bump": "npm run build"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    }
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "printWidth": 80,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": true
  },
  "overrides": {
    "release-it": {
      "undici": "^7.30.1"
    }
  },
  "files": [
    "lib"
  ]
}
